# Copy to .env (git-ignored). Never commit real values.
ANTHROPIC_API_KEY=
# NCBI E-utilities key (raises the rate limit for corpus assembly; optional)
NCBI_API_KEY=
# OMIM API key: harness side only, once Jimmy has submitted the access request
OMIM_API_KEY=
# Harness only. Must be UNSET in any environment that runs extraction;
# pipeline.extract.guard refuses to start if it is set.
