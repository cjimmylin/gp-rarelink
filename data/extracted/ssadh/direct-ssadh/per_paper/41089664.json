    "treatment_summary": {
     "value": "No anticonvulsant drug history. General anesthesia (~120 min) for multiple dental extractions and restorations: no sedative premedication; IV midazolam 0.05 mg/kg, lidocaine 1 mg/kg, propofol 3 mg/kg, fentanyl 1 mcg/kg, rocuronium 0.75 mg/kg; nasotracheal intubation; ondansetron; sevoflurane maintenance in air/oxygen; local 2% lidocaine with epinephrine; Plasma-Lyte fluids; paracetamol and sugammadex at the end; extubated awake, uneventful recovery, discharged the same day. Followed by pediatric metabolism and pediatric neurology.",
     "span": null
    },
    "disease_label_as_stated": {
     "value": "SSADH deficiency",
     "span": null
    },
    "clinical_diagnosis_basis": {
     "value": "molecular genetic analysis showing a homozygous pathogenic mutation in the ALDH5A1 gene; diagnosed after genetic and metabolic tests",
     "span": null
