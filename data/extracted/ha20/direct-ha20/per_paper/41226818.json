    "disease_label_as_stated": {
     "value": "Cornelia de Lange syndrome (CdLS type 4, CdLS4) co-occurring with generalized pustular psoriasis (GPP); the TNFAIP3 variant is described as linked to familial autoinflammatory syndrome but HA20 is not diagnosed",
     "span": null
    },
    "clinical_diagnosis_basis": {
     "value": "Pustular psoriasis confirmed by skin biopsy histopathology (psoriasiform acanthosis, subcorneal neutrophilic pustules; an earlier biopsy at a local center was read as compatible with pemphigus foliaceus); CdLS on clinical features; clinical exome sequencing identified a heterozygous RAD21 variant (CdLS4) and a heterozygous TNFAIP3 variant of uncertain significance",
     "span": null
    },
