    "treatment_summary": {
     "value": "Current therapy GC (glucocorticoids), ADA (adalimumab) started after genetic diagnosis; colchicine refused/not used because of intolerance; no benefit from tonsillectomy. After 6 months of adalimumab, no further recurrence of aphthae, abscesses and fever crises, though IFN score still increased.",
     "span": null
    },
    "disease_label_as_stated": {
     "value": "A20 haploinsufficiency (previously diagnosed with BD)",
     "span": null
    },
    "clinical_diagnosis_basis": {
     "value": "Initial clinical diagnosis of BD by pediatric BD (PEDBD) criteria, 3/6 items (ACR and ACR EULAR SLE criteria: no; HLA B51 -, pathergy -); diagnosis changed to A20 haploinsufficiency after a 17-gene targeted panel found heterozygous TNFAIP3 c.C1135T p.Q379X (causative variants validated by Sanger sequencing in proband and parents when available).",
     "span": null
