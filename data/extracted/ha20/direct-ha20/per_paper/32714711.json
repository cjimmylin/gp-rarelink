    "treatment_summary": {
     "value": "IVIG (repeated doses; temporary responses); oral prednisolone 2 mg/kg/day then tapered (steroid-resistant); single dose of anti-D immunoglobulin (no response); rituximab 375 mg/m^2 weekly x4 (no response); eltrombopag 50 mg daily from March 2018, increased to 75 mg daily in September 2019 (transient response, then loss of response; currently on 75 mg daily); topical tacrolimus for vitiligo",
     "span": null
    },
    "disease_label_as_stated": {
     "value": "chronic ITP and vitiligo with the possibility of auto-inflammatory syndrome Behcet-like (AISBL)",
     "span": null
    },
    "clinical_diagnosis_basis": {
     "value": "ITP diagnosed at a peripheral healthcare center (isolated thrombocytopenia, lowest platelet count 3 x 10^9 cells/L); vitiligo diagnosed by a dermatologist; AISBL suspected from whole-exome sequencing finding a heterozygous TNFAIP3 variant classified as a variant of uncertain significance; segregation analysis not performed, so the diagnosis is unconfirmed",
     "span": null
    },
    "source_reference_in_review": {
     "value": "not reported",
     "span": null
    }
   }
