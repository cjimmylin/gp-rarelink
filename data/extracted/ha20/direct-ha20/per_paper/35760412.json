    "treatment_summary": {
     "value": "Tonsillectomy at 5 years of age (fever then recurred every 3 or 4 months instead of every 1 or 2 months); antipyretics decreased body temperature during episodes; antibiotic treatment ineffective; colchicine started after HA20 diagnosis, and 9 months after treatment oral and genital ulcers disappeared but fever continued to recur every 3 or 4 months; immune suppressants such as steroids and biologics (e.g. TNF-alpha blockers) under consideration.",
     "span": null
    },
    "disease_label_as_stated": {
     "value": "haploinsufficiency A20 (HA20)",
     "span": null
    },
    "clinical_diagnosis_basis": {
     "value": "Next-generation sequencing for genes related to periodic fever and autoinflammatory syndromes revealed a nonsense mutation in TNFAIP3, leading to the diagnosis of HA20; initially Kikuchi disease with PFAPA syndrome was suspected.",
     "span": null
    },
