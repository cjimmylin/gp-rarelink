    "treatment_summary": {
     "value": "Supportive care; phenobarbital for four months in early infancy after a febrile convulsive seizure; colchicine and intermittent courses of prednisolone without meaningful improvement (several months of colchicine); after the genetic diagnosis, escalated to infliximab 5 mg/kg at weeks 0, 2 and 6 then maintenance every eight weeks, colchicine discontinued and corticosteroids tapered, with significant clinical improvement and only one self-limited febrile episode over an eight-month follow-up.",
     "span": null
    },
    "disease_label_as_stated": {
     "value": "Behçet-like autoinflammatory syndrome (HA20)",
     "span": null
    },
    "clinical_diagnosis_basis": {
     "value": "Whole exome sequencing (performed due to atypical presentation and poor response to conventional therapy) identified a likely pathogenic TNFAIP3 variant; initial differentials PFAPA syndrome and familial Mediterranean fever; 12 common MEFV variant alleles tested negative.",
     "span": null
    },
