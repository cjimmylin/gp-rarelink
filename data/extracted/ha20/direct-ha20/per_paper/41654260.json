    "functional_evidence_statement": {
     "value": "Mosaic; Initial VAF 0.059, Reseq VAF 0.057, ddPCR VAF 0.058 (V1 panel); identified in exome analysis (Ghosh et al). Immune cells isolated from blood demonstrated enrichment of the variant in peripheral blood T cells (Figure 4F), but it was absent in T cells from a lymph node biopsy. CADD PHRED 36; gnomAD max pop freq: Novel.",
     "span": null
    },
    "pathogenicity_as_stated_by_authors": {
     "value": "LMP (Likely mosaic pathogenic); previous publications of pathogenicity: None; predicted LOF (stop-gain) leading to premature termination and haploinsufficiency",
     "span": null
    },
    "acmg_criteria_as_stated": {
     "value": "not reported",
     "span": null
    }
