      "cause_of_death": "not reported",
      "treatment_summary": "Oral corticosteroids (prednisolone 40 mg daily) with improvement but steroid dependence; DMARDs hydroxychloroquine, azathioprine and methotrexate, all largely ineffective; tocilizumab (IV 8 mg/kg monthly), started before the genetic diagnosis, with an excellent response; discontinued long-term corticosteroids and remains well controlled on tocilizumab monotherapy for the last 2 years.",
      "disease_label_as_stated": "HA20 (A20 haploinsufficiency); previously diagnosed with AOSD (adult-onset Still's disease)",
      "clinical_diagnosis_basis": "AOSD diagnosed at age 21 based on typical clinical features associated with hyperferritinemia and exclusion of other autoimmune rheumatological diagnoses; HA20 established by exome sequencing (novel heterozygous TNFAIP3 variant), Sanger segregation in family members, cDNA splicing analysis and Western blot showing A20 haploinsufficiency.",
      "source_reference_in_review": "not reported",
      "variants": [
        {
          "gene_symbol_as_stated": "TNFAIP3",
          "variant_original_string": "ENST00000237289 c.1906C>T (GRCh37 6:138200488 rs200138929)",
          "transcript_as_stated": "ENST00000237289",
          "cdna_hgvs_as_stated": "c.1906C>T",
          "protein_hgvs_as_stated": "p.His636fsTer1",
          "genomic_coordinates_as_stated": "GRCh37 6:138200488",
          "variant_type_as_stated": "splice",
          "zygosity": "heterozygous",
          "inheritance": "not reported",
          "parental_testing_statement": "not reported",
          "functional_evidence_statement": "Proband PBMC cDNA showed a mutant allele with deletion of exon 8 (alternatively spliced mRNA); loss of transcript by nonsense-mediated decay resulting in A20 haploinsufficiency confirmed by Western blot; greater percentage of CD14+ monocytes p65-positive after LPS than healthy controls (not statistically significant); increased IL-1beta and IL-18 after LPS+ATP (attenuated by NLRP3 inhibitor MCC950), increased TNFalpha, IL-10, IL-17alpha, IL-1alpha and IL-8 but not IL-6; significantly higher serum ASC specks than healthy control range. Variant not found in ExAC; allele frequency 2.191e-5 on GnomAD.",
          "pathogenicity_as_stated_by_authors": "not reported",
          "acmg_criteria_as_stated": "not reported"
        }
      ],
