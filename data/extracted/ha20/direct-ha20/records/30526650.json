      "treatment_summary": "Prednisolone, which relieved the clinical symptoms and normalized CRP levels.",
      "disease_label_as_stated": "Juvenile onset autoinflammatory disease due to a novel mutation in TNFAIP3 (A20); autoinflammatory phenotype resembling Behçet's disease",
      "clinical_diagnosis_basis": "Features resembling HA20 (periodic fever, oral ulcers, elevated serum pro-inflammatory cytokines TNF-α, IL-1β, IL-6, IL-8) prompted TNFAIP3 gene analysis; heterozygous mutation confirmed by Sanger sequencing; reduced A20 protein expression in PBMCs. HLA-B haplotype was not B51 (B39/B62).",
      "source_reference_in_review": "not reported",
      "variants": [
        {
          "gene_symbol_as_stated": "TNFAIP3",
          "variant_original_string": "C596_598 del A",
          "transcript_as_stated": "not reported",
          "cdna_hgvs_as_stated": "C596_598 del A",
          "protein_hgvs_as_stated": "Cys200Alafsx16; C200Afs*16",
          "genomic_coordinates_as_stated": null,
          "variant_type_as_stated": "frameshift",
          "zygosity": "heterozygous",
          "inheritance": "inherited maternal",
          "parental_testing_statement": "Sanger sequencing of the unaffected father showed no variant of TNFAIP3, suggesting that these mutations were maternally derived (the mother had died of septicaemia 2 years prior; no genotype reported for her).",
          "functional_evidence_statement": "Immunoblot of patient PBMCs vs a healthy control: reduced wild-type A20 protein expression at baseline and after TNF-α stimulation (10 ng/ml, 24 h); cytosolic IκB-α reduced after TNF-α stimulation in patient PBMCs but unchanged in control PBMCs, suggesting accelerated IκB-α degradation.",
          "pathogenicity_as_stated_by_authors": "not reported",
          "acmg_criteria_as_stated": "not reported"
        }
