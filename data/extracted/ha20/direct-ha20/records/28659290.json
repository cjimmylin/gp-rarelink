      "cause_of_death": "not reported",
      "treatment_summary": "Intensive immunosuppression with prednisolone, sirolimus, tacrolimus, infliximab or rituximab (clinical course refractory); recombinant granulocyte colony stimulating factor supporting neutrophils pretransplant; haematopoietic stem cell transplantation; 21 months post-transplant thriving off all immunosuppressive medication with complete remission of autoimmune disease (except diabetes); subcutaneous immunoglobulin supplementation post-HSCT.",
      "disease_label_as_stated": "Early-onset autoimmune disease due to a heterozygous loss-of-function mutation in TNFAIP3 (A20); complex autoimmunity; case described as expanding the clinical spectrum of A20 haploinsufficiency",
      "clinical_diagnosis_basis": "Whole exome sequencing of peripheral blood genomic DNA (Illumina MiSeq) with Ingenuity Variant Analysis filtering, confirmed by capillary (Sanger) sequencing; pathogenic variants in STAT3 and FOXP3 excluded; functional studies in patient dermal fibroblasts",
      "source_reference_in_review": "not reported",
      "variants": [
        {
          "gene_symbol_as_stated": "TNFAIP3",
          "variant_original_string": "c.1466_1467delTG",
          "transcript_as_stated": "not reported",
          "cdna_hgvs_as_stated": "c.1466_1467delTG",
          "protein_hgvs_as_stated": "p.V489Afs*7",
          "genomic_coordinates_as_stated": null,
          "variant_type_as_stated": "frameshift",
          "zygosity": "heterozygous",
          "inheritance": "de novo",
          "parental_testing_statement": "not reported",
          "functional_evidence_statement": "Reduced basal and TNF-alpha-induced A20 protein in patient versus control dermal fibroblasts (immunoblot, N-terminal antibody); exaggerated and prolonged phosphorylation of NF-kB pathway components after TNF-alpha stimulation; RNA-seq showed a significant global increase in range and magnitude of TNF-alpha-stimulated differential gene expression; enhanced IL-6 protein by ELISA (p=0.0015). Inflammasome activation not tested (no leucocyte material).",
          "pathogenicity_as_stated_by_authors": "heterozygous loss-of-function mutation; molecular consequences 'indistinguishable from reported pathogenic A20 mutations'; absent from ExAc/dbSNP",
          "acmg_criteria_as_stated": "not reported"
        }
      ],
