      "cause_of_death": "not reported",
      "treatment_summary": "Colchicine 0.5 mg once daily from November 2018 (after genetic result), increased to 0.5 mg twice daily in January 2019; attacks of abdominal pain and fever stopped, inflammatory parameters and stool calprotectin normalized, growth accelerated; no additional treatment needed so far. Earlier, intussusception at age 7 was resolved by hydro-colon.",
      "disease_label_as_stated": "haploinsufficiency of A20",
      "clinical_diagnosis_basis": "Clinical conclusion of immune dysregulation with autoinflammation resembling a periodic fever syndrome, then NGS (TruSightOne enrichment, filtered on a core panel of autoinflammatory genes) finding a heterozygous truncating TNFAIP3 variant, confirmed by Sanger sequencing; absent in both parents (de novo).",
      "source_reference_in_review": "not reported",
      "variants": [
        {
          "gene_symbol_as_stated": "TNFAIP3",
          "variant_original_string": "NM_006290.3:c.1084C > T",
          "transcript_as_stated": "NM_006290.3",
          "cdna_hgvs_as_stated": "c.1084C > T",
          "protein_hgvs_as_stated": "p.Gln362Ter",
          "genomic_coordinates_as_stated": null,
          "variant_type_as_stated": "nonsense",
          "zygosity": "heterozygous",
          "inheritance": "de novo",
          "parental_testing_statement": "Family segregation analysis was performed in both parents in whom identified mutation was not present. Genetic testing was also performed on the parents. No mutations in the TNFAIP3 gene were found.",
          "functional_evidence_statement": "not reported",
          "pathogenicity_as_stated_by_authors": "disease-causing mutation (as predicted by in silico tools: CADD Phred 36; Mutation taster disease-causing 0,99); novel; not present in dbSNP or gnomAD; confirmed by Sanger sequencing",
          "acmg_criteria_as_stated": "not reported"
        }
