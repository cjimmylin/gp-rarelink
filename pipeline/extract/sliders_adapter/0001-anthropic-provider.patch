@@ -0,0 +1,131 @@
+"""Anthropic (Claude) provider for SLIDERS.
+
+Selected with ``SLIDERS_LLM_PROVIDER=anthropic`` or ``provider="anthropic"``.
+Built on ``langchain-anthropic``, which calls Claude through the official
+``anthropic`` SDK.
+
+Differences from the OpenAI providers that this module absorbs so the rest of
+SLIDERS stays unchanged:
+
+* Structured output uses Claude's native JSON-schema structured outputs
+  (``with_structured_output(..., method="json_schema")``) instead of forced
+  tool calling, which current Claude models reject. The schema-less
+  ``with_structured_output(method="json_mode")`` call used by the extraction
+  chain is mapped to a JSON output parser.
+* Sampling parameters (``temperature``, ``top_p``, ``top_k``) are dropped:
+  current Claude models reject non-default values. Reasoning depth is
+  controlled with ``effort`` instead (per-model config key, or
+  ``SLIDERS_ANTHROPIC_EFFORT``).
+* Server-side refusal fallbacks are enabled by default
+  (``SLIDERS_ANTHROPIC_FALLBACKS=default``; set to ``off`` to disable).
+* Automatic prompt caching is enabled by default via the top-level
+  ``cache_control`` request parameter (``SLIDERS_ANTHROPIC_CACHE=off`` to
+  disable).
+
+Environment: ``ANTHROPIC_API_KEY`` (required), ``ANTHROPIC_BASE_URL``
+(optional).
+"""
+
+from __future__ import annotations
+
+import os
+import uuid
+from typing import Any, Optional
+
+from langchain_anthropic import ChatAnthropic
+from langchain_core.callbacks.base import Callbacks
+from langchain_core.messages import BaseMessage
+from langchain_core.output_parsers.json import JsonOutputParser
+from langchain_core.outputs import LLMResult
+from langchain_core.runnables import Runnable
+
+from sliders.log_utils import logger
+
+FALLBACK_BETA = "server-side-fallback-2026-07-01"
+_SAMPLING_KWARGS = ("temperature", "top_p", "top_k")
+_VALID_EFFORT = {"low", "medium", "high", "xhigh", "max"}
+
+
+def _env_flag(name: str, default: str) -> str:
+    return (os.getenv(name) or default).strip().lower()
+
+
+def build_anthropic_kwargs(
+    *,
+    model: str,
+    max_retries: int,
+    timeout: float | None,
+    kwargs: dict[str, Any],
+) -> dict[str, Any]:
+    """Translate SLIDERS' provider-agnostic kwargs into ChatAnthropic kwargs."""
+    dropped = [k for k in _SAMPLING_KWARGS if k in kwargs]
+    for k in dropped:
+        kwargs.pop(k)
+    if dropped:
+        logger.debug(f"anthropic provider: ignoring sampling kwargs {dropped} for {model}")
+
+    effort = kwargs.pop("effort", None) or kwargs.pop("reasoning_effort", None) or os.getenv("SLIDERS_ANTHROPIC_EFFORT")
+    if effort is not None:
+        effort = str(effort).lower()
+        if effort not in _VALID_EFFORT:
+            raise ValueError(f"anthropic provider: effort must be one of {sorted(_VALID_EFFORT)}, got {effort!r}")
+
+    betas: list[str] = list(kwargs.pop("betas", None) or [])
+    model_kwargs: dict[str, Any] = dict(kwargs.pop("model_kwargs", None) or {})
+
+    fallbacks = _env_flag("SLIDERS_ANTHROPIC_FALLBACKS", "default")
+    if fallbacks == "default":
+        if FALLBACK_BETA not in betas:
+            betas.append(FALLBACK_BETA)
+        model_kwargs.setdefault("fallbacks", "default")
+
+    if _env_flag("SLIDERS_ANTHROPIC_CACHE", "on") in {"on", "1", "true", "yes"}:
+        model_kwargs.setdefault("cache_control", {"type": "ephemeral"})
+
+    api_key = kwargs.pop("api_key", None) or os.getenv("ANTHROPIC_API_KEY")
+    base_url = kwargs.pop("base_url", None) or os.getenv("ANTHROPIC_BASE_URL")
+
+    out: dict[str, Any] = {
+        "model": model,
+        "max_retries": max_retries,
+        "model_kwargs": model_kwargs,
+        **kwargs,
+    }
+    if api_key:
+        out["api_key"] = api_key
+    if base_url:
+        out["base_url"] = base_url
+    if timeout is not None:
+        out["timeout"] = timeout
+    if effort is not None:
+        out["effort"] = effort
+    if betas:
+        out["betas"] = betas
+    return out
+
+
+class SlidersChatAnthropic(ChatAnthropic):
+    """ChatAnthropic with SLIDERS' structured-output conventions.
+
+    The Redis response cache (``CachedLLMMixin``) is mixed in by
+    ``sliders.llm.llm`` to keep this module importable without Redis.
+    """
+
+    def with_structured_output(  # type: ignore[override]
+        self,
+        schema: dict | type | None = None,
+        *,
+        include_raw: bool = False,
+        method: str = "json_schema",
+        **kwargs: Any,
+    ) -> Runnable:
+        if schema is None:
+            # SLIDERS' extraction chain asks for provider "json mode" with no
+            # schema and parses the JSON itself; Claude is instructed by the
+            # prompt to answer with a JSON object, so parse the text.
+            if include_raw:
+                raise ValueError("include_raw is not supported without a schema")
+            return self | JsonOutputParser()
+        if method in {"function_calling", "json_mode"}:
+            method = "json_schema"
+        return super().with_structured_output(schema, include_raw=include_raw, method=method, **kwargs)
