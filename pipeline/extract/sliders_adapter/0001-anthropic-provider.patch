+
+
+class CachedChatAnthropic(CachedLLMMixin, _AnthropicBase if _AnthropicBase is not None else object):
+    """Anthropic (Claude) client with shared caching mixin."""
+
+    @override
+    async def agenerate(
+        self,
+        messages: list[list[BaseMessage]],
+        stop: Optional[list[str]] = None,
+        callbacks: Callbacks = None,
+        *,
+        tags: Optional[list[str]] = None,
+        metadata: Optional[dict[str, Any]] = None,
+        run_name: Optional[str] = None,
+        run_id: Optional[uuid.UUID] = None,
+        **kwargs: Any,
+    ) -> LLMResult:
+        return await self._cached_agenerate(
+            super().agenerate,
+            messages,
+            stop,
+            callbacks,
+            tags=tags,
+            metadata=metadata,
+            run_name=run_name,
+            run_id=run_id,
+            **kwargs,
+        )
