# GP-RareLink .gitignore
# Note: git does not support comments at the end of a line, so every comment
# here sits on its own line.

# --- Licensed or restricted data -------------------------------------------
# OMIM terms restrict redistribution; keep only dated query scripts and
# manifests in git, not OMIM content itself.
data/reference/omim/
# ClinVar/HPO/Mondo snapshots are large and re-downloadable; commit the
# download scripts and dated manifests instead.
data/reference/**/*.vcf
data/reference/**/*.vcf.gz
data/reference/**/*.xml.gz
data/reference/**/*.obo
data/reference/**/*.owl
# Full-text articles: commit PMID manifests and access status only.
data/literature/fulltext/
data/literature/*/fulltext/
data/literature/**/*.pdf
data/literature/**/*.nxml
# Markdown conversions of full text, and screening work files holding PubMed
# abstracts: derived from licensed text, so they stay out of git too.
data/literature/*/fulltext_md/
data/literature/*/fulltext_md_run*/
data/literature/*/supplementary/files/
data/literature/*/screening/work/
data/literature/*/screening_fulltext/work/
# Dated reference snapshots (ground truth): commit only the manifest and the
# counts derived from it, never the content (POC_DESIGN.md Stage 6).
data/reference/*/
!data/reference/*/MANIFEST.json
!data/reference/*/counts.json
# Ontology releases used by the extraction side (re-downloadable).
data/ontologies/**/*.obo
# SLIDERS and other run logs; manifests under runs/ are committed.
runs/**/logs/
runs/**/*.log
uv.lock.bak
# Background papers fetched by background/fetch_papers.* (many are not
# CC-licensed); keep manifest.csv and download_log.csv, not the files.
background/papers/

# --- Large or regenerable pipeline outputs ---------------------------------
data/extracted/**/raw/
data/extracted/**/cache/
*.parquet
*.feather
*.sqlite
*.db

# --- Patient data guard (out of scope for this grant) ----------------------
# Nothing patient-level should ever exist in this repo; this is a backstop.
**/patient*/
**/cohort*/
*.ped

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
credentials*.json

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Editors / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Claude Code local settings (personal, not shared) ----------------------
.claude/settings.local.json
CLAUDE.local.md

# --- Vendored third-party checkouts (scripts/install_sliders.sh) ------------
.vendor/
data/cache/
# Bias-arm comparator papers (held out of extraction; full text is never committed)
data/literature/*/holdouts/

# node tooling for the collaborator deck
analysis/dashboard/node/node_modules/
